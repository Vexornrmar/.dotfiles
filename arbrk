#!/bin/bash

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo "                 _              _     "
echo "   __ _   _ __  | |__    _ __  | | __ "
echo "  / _  | |  __| |  _ \  |  __| | |/ / "
echo " | (_| | | |    | |_) | | |    |   <  "
echo "  \__,_| |_|    |_.__/  |_|    |_|\_\ "

echo "==================="
echo "Installation Script"
echo "==================="

# Function to install programs
install_programs() {
    echo -e "\n${YELLOW}[1/2] Installing programs...${NC}"
    
    if [ ! -f "program_names" ]; then
        echo -e "${RED}Error: program_names file not found!${NC}"
        return 1
    fi
    
    # Update package list first
    echo "Updating package list..."
    sudo apt update
    
    # Read program_names line by line
    while IFS= read -r program || [ -n "$program" ]; do
        # Skip empty lines and comments
        if [[ -z "$program" || "$program" =~ ^# ]]; then
            continue
        fi
        
        # Trim whitespace
        program=$(echo "$program" | xargs)
        
        echo -e "\nChecking $program..."
        
        if command -v "$program" &> /dev/null; then
            echo -e "${GREEN}✓ $program is already installed${NC}"
        else
            echo "Installing $program..."
            if sudo apt install -y "$program"; then
                echo -e "${GREEN}✓ $program installed successfully${NC}"
            else
                echo -e "${RED}✗ Failed to install $program${NC}"
            fi
        fi
    done < "program_names"
}

# Function to copy configuration files
install_configs() {
    echo -e "\n${YELLOW}[2/2] Installing configuration files...${NC}"
    
    if [ ! -f "configuration_names" ]; then
        echo -e "${RED}Error: configuration_names file not found!${NC}"
        return 1
    fi
    
    # Read configuration_names line by line
    while IFS= read -r config || [ -n "$config" ]; do
        # Skip empty lines and comments
        if [[ -z "$config" || "$config" =~ ^# ]]; then
            continue
        fi
        
        # Trim whitespace
        config=$(echo "$config" | xargs)
        
        echo -e "\nProcessing $config..."
        
        # Check if config file exists in Dotfiles
        if [ ! -f "$config" ]; then
            echo -e "${RED}✗ $config not found in Dotfiles folder${NC}"
            continue
        fi
        
        # Check if config exists in home directory
        if [ -f "$HOME/$config" ]; then
            echo "  Existing $config found in home directory. Creating backup..."
            mv "$HOME/$config" "$HOME/${config}.backup.$(date +%Y%m%d_%H%M%S)"
            echo "  Backup created"
        fi
        
        # Copy new config
        echo "  Copying $config to home directory..."
        cp "$config" "$HOME/$config"
        echo -e "${GREEN}✓ $config installed successfully${NC}"
        
    done < "configuration_names"
}

# Main execution
install_programs
install_configs

echo -e "\n${GREEN}================================="
echo "Installation Complete!"
echo -e "=================================${NC}"
